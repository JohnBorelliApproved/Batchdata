# BatchData API key — get this from your BatchData dashboard
BATCHDATA_API_KEY=your_batchdata_key_here

# Public base URL for BatchData webhook callbacks
APP_BASE_URL=https://abeapi.com

# GoHighLevel — agency-level credentials
AGENCY_API_KEY=your_agency_api_key_here
AGENCY_LOCATION_ID=your_agency_location_id_here

# Legacy GHL key (fallback, not required if AGENCY_API_KEY is set)
GOHIGHLEVEL_API_KEY=your_legacy_ghl_key_here

# Path to the local SQLite ledger DB (zip search state, delivery dedup, activity log).
# Defaults to ledger.db next to the app if unset.
LEDGER_DB_PATH=
